<Window x:Class="Aegis.Desktop.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Aegis.Desktop.Wpf"
 Title="AEGIS-SIM | Exercise, Replay and Review" Width="1320" Height="1040"
 MinWidth="1120" MinHeight="960" Background="#F3F5F7" FontFamily="Segoe UI"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="22,10" />
   <Setter Property="Margin" Value="0,0,10,0" />
   <Setter Property="FontSize" Value="14" />
   <Setter Property="MinWidth" Value="100" />
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False" />
   <Setter Property="IsReadOnly" Value="True" />
   <Setter Property="CanUserAddRows" Value="False" />
   <Setter Property="HeadersVisibility" Value="Column" />
   <Setter Property="RowHeight" Value="34" />
   <Setter Property="GridLinesVisibility" Value="Horizontal" />
   <Setter Property="BorderBrush" Value="#D9E1E8" />
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="AEGIS-SIM" FontSize="30" FontWeight="Bold" Foreground="#173C4F"/>
   <TextBlock Text="RESPONSE WORKSPACE / 01     ·     Offline synthetic map + deterministic simulation" Foreground="#526878" FontSize="15" Margin="0,6,0,0"/>
   <WrapPanel Margin="0,12,0,0">
    <Button Content="Import scenario" Tag="Import" Click="Workspace_Click" IsEnabled="{Binding IsLocal}" Padding="12,6"/>
    <Button Content="Export JSON/XML" Tag="Export" Click="Workspace_Click" Padding="12,6"/>
    <Button Content="Saved runs / A/B" Tag="History" Click="Workspace_Click" IsEnabled="{Binding IsLocal}" Padding="12,6"/>
    <Button Content="Export report" Tag="Report" Click="Workspace_Click" Padding="12,6"/>
    <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#277B65" Margin="8,0"/>
   </WrapPanel>
   <TextBlock Text="{Binding RunLabel}" Foreground="#526878" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#173C4F" CornerRadius="8" Padding="20" Margin="0,0,0,20">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="RUN STATUS" Foreground="#B8D5DF"/><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="White" FontSize="26"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="CURRENT TICK" Foreground="#B8D5DF"/><TextBlock x:Name="TickText" Text="{Binding Tick}" Foreground="White" FontSize="26"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="PACKETS REMAINING" Foreground="#B8D5DF"/><TextBlock Text="{Binding Remaining}" Foreground="White" FontSize="26"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,20">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="StartButton" Content="{Binding StartLabel}" Command="{Binding StartCommand}" AutomationProperties.Name="Start or resume simulation"/>
    <Button x:Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}"/>
    <Button x:Name="StepButton" Content="Step" Command="{Binding StepCommand}"/>
    <Button x:Name="ResetButton" Content="Reset" Command="{Binding ResetCommand}"/>
    <Button x:Name="ClosureButton" Content="Close selected route · 5 ticks" Command="{Binding CloseRouteCommand}" Padding="14,10"/>
   </StackPanel>
   <TextBlock Text="{Binding Summary}" FontSize="15" Margin="0,12,0,0"/>
   <ProgressBar Value="{Binding CompletionPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,10,0,0" Foreground="#277B65" Background="#DEE7E3" BorderThickness="0"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#526878" FontSize="12" Margin="0,8,0,0"/>
   <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsReplay}">
    <TextBlock Text="REPLAY TICK" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"/>
    <Slider x:Name="ReplaySlider" Minimum="0" Maximum="{Binding MaxReplayTick}" Value="{Binding ReplayTick, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
   </DockPanel>
  </StackPanel>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" MinWidth="36" Padding="8,2" ToolTip="Zoom in"/>
     <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" MinWidth="36" Padding="8,2" ToolTip="Zoom out"/>
     <Button x:Name="FitMapButton" Content="Fit map" Click="FitMap_Click" MinWidth="70" Padding="8,2"/>
    </StackPanel>
    <TextBlock Text="SYNTHETIC AREA MAP" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <Border Grid.Row="1" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <local:SyntheticMap x:Name="AreaMap" Nodes="{Binding MapNodes}" SelectedName="{Binding SelectedShelterName, Mode=TwoWay}" LastDelivery="{Binding LastDeliveryShelter}" AutomationProperties.Name="Synthetic map. Select a shelter from the adjacent list for keyboard access."/>
     <Border Grid.Row="1" Background="White" Padding="14,10">
      <TextBlock Text="Waiting / green: supplied / red: route closed / amber: last delivery&#x0a;Scroll: zoom · Drag: pan · Home: fit · Synthetic local meters" Foreground="#526878" FontSize="11" TextWrapping="Wrap"/>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.RowSpan="2" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="INSPECT SHELTER" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ComboBox x:Name="ShelterPicker" Grid.Row="1" ItemsSource="{Binding ShelterNames}" SelectedItem="{Binding SelectedShelterName, Mode=TwoWay}" Padding="8" AutomationProperties.Name="Select shelter"/>
    <TextBlock x:Name="SelectedDetailText" Grid.Row="2" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,8,0,14" Foreground="#526878"/>
   <DataGrid x:Name="ShelterGrid" Grid.Row="3" ItemsSource="{Binding Shelters}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Shelter" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Initial" Binding="{Binding InitialDemand}" Width="65"/>
     <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="85"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="4" Text="DELIVERY HISTORY" FontWeight="SemiBold" Margin="0,16,0,10"/>
   <DataGrid x:Name="EventGrid" Grid.Row="5" ItemsSource="{Binding Events}" RowHeight="26">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Tick" Binding="{Binding Tick}" Width="60"/>
     <DataGridTextColumn Header="Shelter" Binding="{Binding Shelter}" Width="*"/>
     <DataGridTextColumn Header="Packets" Binding="{Binding Amount}" Width="80"/>
    </DataGrid.Columns>
   </DataGrid>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="4" Margin="0,18,0,0" Foreground="#526878" TextWrapping="Wrap"
   Text="SYNTHETIC TRAINING DATA · Fresh load per visit; no travel-time physics. Local commands autosave to SQLite. Reset creates a new run; saved history remains."/>
 </Grid>
</Window>
