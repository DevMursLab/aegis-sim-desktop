<Window x:Class="Aegis.Desktop.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Aegis.Desktop.Wpf"
 Title="AEGIS-SIM | Exercise, Replay and Review" Width="1320" Height="1040"
 MinWidth="1120" MinHeight="960" Background="#F3F5F7" FontFamily="Segoe UI"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="22,10" />
   <Setter Property="Margin" Value="0,0,10,0" />
   <Setter Property="FontSize" Value="14" />
   <Setter Property="MinWidth" Value="100" />
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False" />
   <Setter Property="IsReadOnly" Value="True" />
   <Setter Property="CanUserAddRows" Value="False" />
   <Setter Property="HeadersVisibility" Value="Column" />
   <Setter Property="RowHeight" Value="34" />
   <Setter Property="GridLinesVisibility" Value="Horizontal" />
   <Setter Property="BorderBrush" Value="#D9E1E8" />
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="AEGIS-SIM" FontSize="30" FontWeight="Bold" Foreground="#173C4F"/>
   <TextBlock Text="RESPONSE WORKSPACE / 01     ·     Offline synthetic map + deterministic simulation" Foreground="#526878" FontSize="15" Margin="0,6,0,0"/>
   <WrapPanel Margin="0,12,0,0">
    <Button Content="Import scenario" Tag="Import" Click="Workspace_Click" IsEnabled="{Binding IsLocal}" Padding="12,6"/>
    <Button x:Name="LogisticsDemoButton" Content="Stock + travel demo" Tag="Logistics" Click="Workspace_Click" IsEnabled="{Binding IsLocal}" Padding="12,6"/>
    <Button Content="Export JSON/XML" Tag="Export" Click="Workspace_Click" Padding="12,6"/>
    <Button Content="Saved runs / A/B" Tag="History" Click="Workspace_Click" IsEnabled="{Binding IsLocal}" Padding="12,6"/>
    <Button Content="Export report" Tag="Report" Click="Workspace_Click" Padding="12,6"/>
    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
     <MenuItem Header="Tools">
      <MenuItem x:Name="EditorMenu" Header="Scenario editor" Tag="Editor" Click="Workspace_Click" IsEnabled="{Binding CanEditScenario}"/>
      <MenuItem x:Name="FleetDemoMenu" Header="Three-vehicle demo" Tag="Fleet" Click="Workspace_Click" IsEnabled="{Binding IsLocal}"/>
      <MenuItem x:Name="PriorityDemoMenu" Header="Priority + limited stock demo" Tag="Priority" Click="Workspace_Click" IsEnabled="{Binding IsLocal}"/>
      <MenuItem x:Name="GeoDemoMenu" Header="Road network demo" Tag="GeoDemo" Click="Workspace_Click" IsEnabled="{Binding IsLocal}"/>
      <MenuItem x:Name="LayersMenu" Header="Offline GeoJSON layers" Tag="Layers" Click="Workspace_Click"/>
      <MenuItem Header="{Binding PlaybackSpeedLabel}" IsEnabled="{Binding CanChangePlaybackSpeed}">
       <MenuItem Header="1x" Tag="Speed1" Click="Workspace_Click"/>
       <MenuItem Header="2x" Tag="Speed2" Click="Workspace_Click"/>
       <MenuItem x:Name="SpeedFastMenu" Header="4x" Tag="Speed4" Click="Workspace_Click"/>
      </MenuItem>
      <MenuItem x:Name="ForecastMenu" Header="Synthetic forecast lab" Tag="Forecast" Click="Workspace_Click"/>
      <MenuItem Header="Cancel report export" Tag="CancelReport" Click="Workspace_Click"/>
      <MenuItem x:Name="PreviewMenu" Header="Completion preview" Tag="Preview" Click="Workspace_Click"/>
      <MenuItem x:Name="DiagnosticsMenu" Header="Export diagnostics" Tag="Diagnostics" Click="Workspace_Click"/>
     </MenuItem>
    </Menu>
    <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#277B65" Margin="8,0"/>
   </WrapPanel>
   <TextBlock Text="{Binding RunLabel}" Foreground="#526878" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#173C4F" CornerRadius="8" Padding="20" Margin="0,0,0,20">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="RUN STATUS" Foreground="#B8D5DF"/><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="White" FontSize="26"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="CURRENT TICK" Foreground="#B8D5DF"/><TextBlock x:Name="TickText" Text="{Binding Tick}" Foreground="White" FontSize="26"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="PACKETS REMAINING" Foreground="#B8D5DF"/><TextBlock Text="{Binding Remaining}" Foreground="White" FontSize="26"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,20">
   <WrapPanel>
    <Button x:Name="StartButton" Content="{Binding StartLabel}" Command="{Binding StartCommand}" AutomationProperties.Name="Start or resume simulation"/>
    <Button x:Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}"/>
    <Button x:Name="StepButton" Content="Step" Command="{Binding StepCommand}"/>
    <Button x:Name="ResetButton" Content="Reset" Command="{Binding ResetCommand}"/>
    <Button x:Name="ClosureButton" Content="Close selected route · 5 ticks" Command="{Binding CloseRouteCommand}" Padding="14,10"/>
    <Button x:Name="RestockButton" Content="Restock +20" Command="{Binding RestockCommand}" Padding="14,10"/>
   </WrapPanel>
   <TextBlock Text="{Binding Summary}" FontSize="15" Margin="0,12,0,0"/>
   <TextBlock x:Name="StockText" Text="{Binding StockLabel}" Foreground="#173C4F" FontSize="12" Margin="0,6,0,0"/>
   <TextBlock x:Name="VehicleText" Text="{Binding VehicleLabel}" Foreground="#526878" FontSize="12" Margin="0,3,0,0"/>
   <ProgressBar Value="{Binding CompletionPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,10,0,0" Foreground="#277B65" Background="#DEE7E3" BorderThickness="0"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#526878" FontSize="12" Margin="0,8,0,0"/>
   <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsReplay}">
    <TextBlock Text="REPLAY TICK" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"/>
    <Slider x:Name="ReplaySlider" Minimum="0" Maximum="{Binding MaxReplayTick}" Value="{Binding ReplayTick, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
   </DockPanel>
  </StackPanel>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" MinWidth="36" Padding="8,2" ToolTip="Zoom in"/>
     <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" MinWidth="36" Padding="8,2" ToolTip="Zoom out"/>
     <Button x:Name="FitMapButton" Content="Fit map" Click="FitMap_Click" MinWidth="70" Padding="8,2"/>
    </StackPanel>
    <TextBlock Text="SYNTHETIC AREA MAP" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <Border Grid.Row="1" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <local:SyntheticMap x:Name="AreaMap" Nodes="{Binding MapNodes}" SelectedName="{Binding SelectedShelterName, Mode=TwoWay}" LastDelivery="{Binding LastDeliveryShelter}" HasVehicle="{Binding UsesLogistics}" FleetVehicles="{Binding MapVehicles}" Geography="{Binding Geography}" ClosedRoadIds="{Binding ClosedRoadIds}" ActiveRoadRoutes="{Binding ActiveRoadRoutes}" DepotX="{Binding DepotX}" DepotY="{Binding DepotY}" VehicleX="{Binding VehiclePosition.X}" VehicleY="{Binding VehiclePosition.Y}" VehicleDestination="{Binding VehicleDestination}" AutomationProperties.Name="Synthetic map. Select a shelter from the adjacent list for keyboard access."/>
     <Border Grid.Row="1" Background="White" Padding="14,10">
      <TextBlock Text="Green: supplied / red: closed / amber: vehicles or last visit&#x0a;Scroll: zoom · Drag: pan · Home: fit · Synthetic local meters" Foreground="#526878" FontSize="11" TextWrapping="Wrap"/>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.RowSpan="2" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="INSPECT SHELTER" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <StackPanel Grid.Row="1">
     <ComboBox x:Name="ShelterPicker" ItemsSource="{Binding ShelterNames}" SelectedItem="{Binding SelectedShelterName, Mode=TwoWay}" Padding="8" AutomationProperties.Name="Select shelter"/>
     <StackPanel Margin="0,8,0,0">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Geography}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <DockPanel>
       <Button x:Name="JunctionRoutingButton" DockPanel.Dock="Right" Content="Use junction routing" Command="{Binding EnableJunctionRoutingCommand}" Padding="8,6" Margin="8,0,0,0" ToolTip="Enable while all vehicles are at the depot. Entered roads finish; new paths are chosen at nodes."/>
       <Button x:Name="RoadClosureButton" DockPanel.Dock="Right" Content="Close road / 5 ticks" Command="{Binding CloseRoadCommand}" Padding="8,6" Margin="8,0,0,0"/>
       <ComboBox x:Name="RoadPicker" ItemsSource="{Binding RoadIds}" SelectedItem="{Binding SelectedRoadId, Mode=TwoWay}" Padding="8" AutomationProperties.Name="Select shared road"/>
      </DockPanel>
      <TextBlock Text="{Binding RoadIncidentLabel}" ToolTip="{Binding RoadIncidentLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
     </StackPanel>
    </StackPanel>
    <TextBlock x:Name="SelectedDetailText" Grid.Row="2" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,8,0,14" Foreground="#526878"/>
   <DataGrid x:Name="ShelterGrid" Grid.Row="3" ItemsSource="{Binding Shelters}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Shelter" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Initial" Binding="{Binding InitialDemand}" Width="65"/>
     <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="85"/>
     <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock x:Name="DecisionReasonText" Grid.Row="6" Text="{Binding ElementName=EventGrid, Path=SelectedItem.Reason, TargetNullValue='Select a priority dispatch row to inspect its decision.'}" TextWrapping="Wrap" FontSize="11" Foreground="#526878" Margin="0,8,0,0"/>
   <TextBlock Grid.Row="4" Text="EXERCISE HISTORY" FontWeight="SemiBold" Margin="0,16,0,10"/>
   <DataGrid x:Name="EventGrid" Grid.Row="5" ItemsSource="{Binding EventRows}" RowHeight="26">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Tick" Binding="{Binding Tick}" Width="40"/>
     <DataGridTextColumn Header="Vehicle" Binding="{Binding Vehicle}" Width="90"/>
     <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="95"/>
     <DataGridTextColumn Header="Shelter" Binding="{Binding Shelter}" Width="*"/>
     <DataGridTextColumn Header="Packets" Binding="{Binding Amount}" Width="60"/>
    </DataGrid.Columns>
   </DataGrid>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="4" Margin="0,18,0,0" Foreground="#526878" TextWrapping="Wrap"
   Text="SYNTHETIC TRAINING DATA · Finite stock and configured travel ticks; legacy instant visits supported. SQLite autosave; Reset creates a new run."/>
 </Grid>
</Window>
